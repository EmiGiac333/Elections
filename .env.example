# Copia questo file in .env oppure esporta le variabili nella shell.
# Serve UNA sola delle opzioni qui sotto.

# --- Opzione 1: modello locale, gratuito e senza account (consigliata) --------
# Installa Ollama da https://ollama.com, poi: ollama pull llama3.1:8b
# Non serve nessuna variabile: viene rilevato da solo.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# OLLAMA_URL=http://localhost:11434

# --- Opzione 2: piano gratuito nel cloud -------------------------------------
# Basta la chiave del servizio che vuoi usare: il provider viene rilevato da lì.

# Groq — chiave gratuita da https://console.groq.com/keys
# GROQ_API_KEY=

# Google Gemini — chiave gratuita da https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OpenRouter — chiave gratuita da https://openrouter.ai/keys (modelli ":free")
# OPENROUTER_API_KEY=

# --- Opzione 3: Anthropic, a pagamento ---------------------------------------
# Richiede anche: npm install @anthropic-ai/sdk
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Parametri comuni --------------------------------------------------------
# Modello da usare, se diverso dal predefinito del provider
# AI_MODEL=

# Quanti collegi chiedere per richiesta (più bassi = più affidabile sui modelli piccoli)
# AI_STATE_CHUNK=8

# Attesa massima per una risposta del modello, in millisecondi
# AI_TIMEOUT_MS=180000

# Porta del server
# PORT=3000
